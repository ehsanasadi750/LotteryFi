import { useState, useEffect } from 'react';
import { Clock, Trophy, Ticket as TicketIcon } from 'lucide-react';
import { useReadContracts } from 'wagmi';
import { formatUnits } from 'viem';
import { LOTTERY_ADDRESS, LOTTERY_ABI } from '../constants';

export function HeroBanner() {
  const [timeLeft, setTimeLeft] = useState({ hours: 0, minutes: 0, seconds: 0 });

  const lotteryContract = {
    address: LOTTERY_ADDRESS,
    abi: LOTTERY_ABI,
  } as const;

  const { data } = useReadContracts({
    contracts: [
      { ...lotteryContract, functionName: 'currentRound' },
      { ...lotteryContract, functionName: 'getCurrentPrizePool' },
      { ...lotteryContract, functionName: 'getTotalTicketsInCurrentRound' },
      { ...lotteryContract, functionName: 'roundEndTime' },
    ],
    query: {
      refetchInterval: 10000,
    }
  });

  const [currentRound, currentPrizePool, totalTickets, roundEndTime] = data || [];

  useEffect(() => {
    if (!roundEndTime?.result) return;
    
    const endTime = Number(roundEndTime.result) * 1000;

    const timer = setInterval(() => {
      const now = Date.now();
      const diff = endTime - now;

      if (diff <= 0) {
        setTimeLeft({ hours: 0, minutes: 0, seconds: 0 });
        clearInterval(timer);
        return;
      }

      const h = Math.floor(diff / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);

      setTimeLeft({ hours: h, minutes: m, seconds: s });
    }, 1000);

    return () => clearInterval(timer);
  }, [roundEndTime?.result]);

  const formatTime = (v: number) => v.toString().padStart(2, '0');
  
  const formattedPrizePool = currentPrizePool?.result !== undefined 
    ? Number(formatUnits(currentPrizePool.result, 6)).toLocaleString() 
    : '0';

  return (
    <div className="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700 p-8 md:p-12 text-center md:text-left flex flex-col md:flex-row items-center justify-between">
      <div className="absolute inset-0 opacity-20" style={{ backgroundImage: 'radial-gradient(circle at 2px 2px, rgba(255,255,255,0.1) 1px, transparent 0)', backgroundSize: '24px 24px' }}></div>
      <div className="absolute top-0 right-0 -mt-16 -mr-16 w-64 h-64 bg-cyan-500/20 rounded-full blur-[80px]"></div>
      
      <div className="relative z-10 mb-8 md:mb-0">
        <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-900/30 text-cyan-400 border border-cyan-800/50 text-sm font-medium mb-6">
          <span className="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          Round #{currentRound?.result !== undefined ? String(currentRound.result) : '...'} Active
        </div>
        <h1 className="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">
          Win the <span className="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Prize Pool</span>
        </h1>
        <div className="flex items-center justify-center md:justify-start gap-4 text-slate-300">
          <div className="flex items-center gap-1.5">
            <TicketIcon className="w-5 h-5 text-slate-400" />
            <span>{totalTickets?.result !== undefined ? String(totalTickets.result) : '0'} Tickets Sold</span>
          </div>
        </div>
      </div>

      <div className="relative z-10 flex flex-col gap-4 min-w-[280px]">
        <div className="bg-slate-950/50 backdrop-blur-sm border border-slate-700/50 rounded-xl p-6 text-center">
          <p className="text-slate-400 text-sm font-medium mb-1 flex items-center justify-center gap-2">
            <Trophy className="w-4 h-4" /> Current Pool
          </p>
          <p className="text-3xl md:text-4xl font-bold text-white">
            {formattedPrizePool} <span className="text-cyan-400 text-2xl">USDC</span>
          </p>
        </div>
        <div className="bg-slate-950/50 backdrop-blur-sm border border-slate-700/50 rounded-xl p-4 flex items-center justify-center gap-4">
          <Clock className="w-5 h-5 text-cyan-400" />
          <div className="flex gap-2 font-mono text-xl font-semibold text-white text-center">
            <div className="flex flex-col"><span className="leading-none">{formatTime(timeLeft.hours)}</span><span className="text-[10px] text-slate-500 font-sans uppercase mt-1 tracking-wider">Hrs</span></div>
            <span className="text-slate-600">:</span>
            <div className="flex flex-col"><span className="leading-none">{formatTime(timeLeft.minutes)}</span><span className="text-[10px] text-slate-500 font-sans uppercase mt-1 tracking-wider">Min</span></div>
            <span className="text-slate-600">:</span>
            <div className="flex flex-col"><span className="leading-none">{formatTime(timeLeft.seconds)}</span><span className="text-[10px] text-slate-500 font-sans uppercase mt-1 tracking-wider">Sec</span></div>
          </div>
        </div>
      </div>
    </div>
  );
}
